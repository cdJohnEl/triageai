rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo rules: anonymous clinic devices may create and read zero-PII sessions.
    // For production, require Firebase Auth and scope documents per clinic.
    match /triage_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly([
        'age_group', 'sex', 'vitals', 'duration_days', 'symptoms_raw',
        'triage_level', 'triage_output', 'created_at'
      ]);
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
